APP_ENV=production
APP_BASE_DIR=/opt/phone-agent
APP_PUBLIC_NAME="OpenVoice AI"

LLM_PROVIDER=nvidia
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-lite-001
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=80
OPENROUTER_TEMPERATURE=0.25
OPENROUTER_TOP_P=0.8
OPENROUTER_STREAM=true
OPENROUTER_HTTP_REFERER=https://openvoice-ai.local
OPENROUTER_APP_TITLE=OpenVoice AI

N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=

MAIL_FROM=
MAIL_FROM_NAME="OpenVoice AI"
INTERNAL_SUMMARY_TO=
DASHBOARD_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=de

PIPER_BIN=/usr/local/bin/piper
PIPER_MODEL=/opt/phone-agent/models/piper/de_DE-thorsten-medium.onnx
PIPER_CONFIG=/opt/phone-agent/models/piper/de_DE-thorsten-medium.onnx.json

ASTERISK_SOUNDS_DIR=/var/lib/asterisk/sounds/phone-agent
MAX_TURNS=8
MAX_LLM_ROUNDS_PER_CALL=10
RECORD_SECONDS=7
SILENCE_SECONDS=1.4
MIN_RECORD_SECONDS=1.4
POST_PLAYBACK_WAIT_SECONDS=0.4

CLOUDFLARE_TUNNEL_HOSTNAME=
CLOUDFLARE_ACCESS_REQUIRED=true
