; Beispiel fuer eine FRITZ!Box-SIP-Nebenstelle.
; Werte nicht raten: Benutzername, Passwort und FRITZ!Box-IP aus der echten Box uebernehmen.

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060

[fritzbox]
type=registration
transport=transport-udp
outbound_auth=fritzbox-auth
server_uri=sip:FRITZBOX_IP
client_uri=sip:SIP_USERNAME@FRITZBOX_IP
retry_interval=60
forbidden_retry_interval=300
expiration=300

[fritzbox-auth]
type=auth
auth_type=userpass
username=SIP_USERNAME
password=SIP_PASSWORD

[fritzbox-aor]
type=aor
contact=sip:FRITZBOX_IP
qualify_frequency=30

[fritzbox-endpoint]
type=endpoint
transport=transport-udp
context=from-fritzbox
disallow=all
allow=alaw,ulaw
dtmf_mode=rfc4733
outbound_auth=fritzbox-auth
aors=fritzbox-aor
direct_media=no
from_user=SIP_USERNAME
from_domain=FRITZBOX_IP

[fritzbox-identify]
type=identify
endpoint=fritzbox-endpoint
match=FRITZBOX_IP
