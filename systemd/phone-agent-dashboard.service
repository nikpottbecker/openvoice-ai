[Unit]
Description=Phone Agent Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/phone-agent
EnvironmentFile=/opt/phone-agent/.env
Environment=PYTHONPATH=/opt/phone-agent/src
Environment=DASHBOARD_REQUIRE_ACCESS=true
ExecStart=/opt/phone-agent/.venv/bin/uvicorn phone_agent.dashboard.app:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
